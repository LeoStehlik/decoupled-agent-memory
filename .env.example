POSTGRES_DB=supavault
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
AUTH_DB_PASSWORD=change-me
SUPABASE_JWT_SECRET=replace-with-a-long-random-secret
SUPABASE_URL=http://KOBE_IP
SUPABASE_AUTH_EXTERNAL_URL=http://KOBE_IP/auth/v1
SUPABASE_ANON_KEY=public-anon-key
# Optional service-token path for trusted local MCP clients. Use a long random value.
LOCAL_USER_ID=00000000-0000-0000-0000-000000000001
STATIC_BEARER_TOKEN=replace-with-long-random-mcp-token
NEXT_PUBLIC_SUPABASE_URL=http://KOBE_IP
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key
NEXT_PUBLIC_API_URL=http://KOBE_IP/api
NEXT_PUBLIC_MCP_URL=http://KOBE_IP/mcp
# Optional: set one canonical browser origin to avoid split sessions/users when the same stack is reached by multiple internal IPs or hostnames.
# Example: NEXT_PUBLIC_CANONICAL_HOST=brain.internal
# Example: NEXT_PUBLIC_CANONICAL_REDIRECT_HOSTS=KOBE_IP,ALT_KOBE_IP
NEXT_PUBLIC_CANONICAL_HOST=
NEXT_PUBLIC_CANONICAL_REDIRECT_HOSTS=
APP_URL=http://KOBE_IP
APP_URLS=http://KOBE_IP,http://MAC_MINI_IP
MCP_URL=http://KOBE_IP/mcp
API_IMAGE=ghcr.io/leostehlik/llm-wiki-api:latest
WEB_IMAGE=ghcr.io/leostehlik/llm-wiki-web:latest
MCP_IMAGE=ghcr.io/leostehlik/llm-wiki-mcp:latest

GOTRUE_DISABLE_SIGNUP=false
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
